{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "lib": ["ES2022", "DOM"],
    "moduleResolution": "node", "outDir": "dist", "rootDir": "src",
    "strict": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
